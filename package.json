{
  "name": "gomuuv",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "debug-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && gradlew assembleDebug && cd ..",
    "release:build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && ./gradlew assembleRelease && cd ..",
    "android": "expo run:android",
    "ios": "NODE_ENV=development expo run:ios",
    "web": "NODE_ENV=development expo start --web"
  },
